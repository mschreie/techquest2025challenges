#!/usr/bin/env bash
set -euo pipefail

CSS='
:root {
  --bg: #ffffff;
  --text: #1f2328;
  --muted: #59636e;
  --border: #d0d7de;
  --code-bg: #f6f8fa;
  --accent: #ee0000;
}
* { box-sizing: border-box; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.65;
  color: var(--text);
  background: var(--bg);
  max-width: 960px;
  margin: 2rem auto;
  padding: 0 1.5rem 4rem;
}
h1, h2, h3, h4 { margin-top: 1.6em; margin-bottom: 0.6em; line-height: 1.25; font-weight: 600; }
h1 { font-size: 2rem; border-bottom: 2px solid var(--accent); padding-bottom: 0.35em; }
h2 { font-size: 1.45rem; border-bottom: 1px solid var(--border); padding-bottom: 0.25em; }
a { color: #0969da; text-decoration: none; }
a:hover { text-decoration: underline; }
code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.9em;
  background: var(--code-bg);
  padding: 0.15em 0.4em;
  border-radius: 4px;
}
pre {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-left: 4px solid var(--accent);
  border-radius: 6px;
  padding: 1rem 1.25rem;
  overflow-x: auto;
  line-height: 1.45;
}
pre code { background: transparent; padding: 0; font-size: 0.88em; }
table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 0.95em; }
th, td { border: 1px solid var(--border); padding: 0.6rem 0.85rem; text-align: left; }
th { background: var(--code-bg); font-weight: 600; }
tr:nth-child(even) td { background: #fbfcfd; }
blockquote {
  margin: 1rem 0;
  padding: 0.5rem 1rem;
  border-left: 4px solid var(--border);
  color: var(--muted);
  background: #f9fafb;
}
hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
'

CSS_B64=$(printf '%s' "$CSS" | base64 -w 0)

exec /usr/bin/pandoc \
  -f markdown+gfm_auto_identifiers \
  -t html5 \
  --standalone \
  --metadata title="RHEL Image Mode Workshop" \
  --css="data:text/css;base64,${CSS_B64}"

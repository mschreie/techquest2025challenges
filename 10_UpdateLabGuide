. ./env.sh

# changed: apply the cluster-specific host-key policy when connecting to util.
vssh() {
    local namespace=$1
    shift
    virtctl -n "$namespace" ssh --known-hosts "$SSH_KNOWN_HOSTS" \
        --local-ssh-opts='-o StrictHostKeyChecking=accept-new' "$@"
}

for CLUSTERID in $MUTLICLUSTERID
do 
    echo $CLUSTERID
     # changed: keep different clusters' VM host keys separate
    SSH_KNOWN_HOSTS="$HOME/.ssh/kubevirt_known_hosts-$CLUSTERID"
    mkdir -p "$HOME/.ssh"
    touch "$SSH_KNOWN_HOSTS"
    chmod 600 "$SSH_KNOWN_HOSTS
    PW=ADMINPW_$CLUSTERID  
    PW=${!PW}
    echo $PW
    echo "Login to cluster...."
    oc login -u admin -p $PW https://api.cluster-${CLUSTERID}.dyn.redhatworkshops.io:6443/

    echo Testing the login first
    virtctl -n default ssh -i ~/.ssh/id_techquest cloud-user@vmi/util  -c "hostname" 

    COPYFILE_DISABLE=1 tar -C labguide -cf - . | virtctl -n default ssh -i ~/.ssh/id_techquest -c 'sudo tar xf - -C /var/www/html' cloud-user@vmi/util
done

